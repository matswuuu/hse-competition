# Used for local runs only. In production .env is generated by the deploy job
# from GitHub secrets/variables (see .github/workflows/ci-cd.yml).
POSTGRES_DB=hse_competition
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Domain Caddy serves and issues a TLS certificate for.
# SITE_ADDRESS=hse-competition.matswuuu.dev

# LLM meal planner (§4.3). Leave unset to use the code-only demo planner.
# SPRING_PROFILES_ACTIVE=llm
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# BACKEND_IMAGE=ghcr.io/matswuuu/hse-competition-backend
# FRONTEND_IMAGE=ghcr.io/matswuuu/hse-competition-frontend
# IMAGE_TAG=latest
